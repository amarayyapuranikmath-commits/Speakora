{
  "$comment": "Single source of truth for the website and the Android app. Edit this file, then run: node design/build-tokens.cjs",
  "color": {
    "canvas": "#FAFAF8",
    "surface": "#FFFFFF",
    "ink": "#14171A",
    "muted": "#55606B",
    "subtle": "#656F79",
    "line": "#E5E3DE",
    "lineStrong": "#CFCCC4",
    "field": "#858C93",
    "navy": "#0B1F4B",
    "accent": "#1D4ED8",
    "accentHover": "#1E40AF",
    "accentSoft": "#E8EEFB",
    "danger": "#B42318",
    "dangerSoft": "#FDECEA",
    "warning": "#8A5A00",
    "warningSoft": "#FDF3DC",
    "success": "#1D6B3A",
    "successSoft": "#E6F3EA",
    "white": "#FFFFFF"
  },
  "radius": { "control": 8, "panel": 12, "pill": 999 },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48, "huge": 64, "giant": 96 },
  "type": {
    "display": { "size": 56, "line": 62, "weight": 600, "tracking": -0.03 },
    "title": { "size": 28, "line": 34, "weight": 600, "tracking": -0.02 },
    "heading": { "size": 20, "line": 28, "weight": 600, "tracking": -0.015 },
    "subheading": { "size": 16, "line": 24, "weight": 600, "tracking": -0.005 },
    "body": { "size": 16, "line": 26, "weight": 400, "tracking": 0 },
    "small": { "size": 14, "line": 20, "weight": 400, "tracking": 0 },
    "caption": { "size": 12, "line": 16, "weight": 500, "tracking": 0.01 }
  },
  "layout": { "reading": 640, "app": 1024, "gutter": 20 },
  "motion": { "fast": 120, "base": 200, "slow": 320, "easing": "cubic-bezier(0.2, 0, 0, 1)" },
  "elevation": { "overlay": "0 12px 32px rgba(20, 23, 26, 0.14)" },
  "android": {
    "$comment": "Android only (the website has one light theme). \"light\" adds colours that exist only in the app; \"dark\" is the complete dark palette, chosen for contrast (text 4.5:1 or better, tested in mobile/__tests__/theme.test.ts), not by inverting the light one. onAccent is the colour of text and icons on an accent or danger fill.",
    "light": { "onAccent": "#FFFFFF", "wash": "#F0EFEC", "bubble": "#EEEDE8", "scrim": "rgba(0,0,0,0.4)" },
    "dark": {
      "canvas": "#0F1215", "surface": "#171B20", "ink": "#ECEFF3", "muted": "#A9B1BA", "subtle": "#9AA3AD", "line": "#262B32", "lineStrong": "#3D444D", "field": "#8B949E",
      "navy": "#E3EBFF", "accent": "#6F9BFF", "accentHover": "#8FB1FF", "accentSoft": "#1B2A4A",
      "danger": "#FF8F85", "dangerSoft": "#3B1D1D", "warning": "#F0B84A", "warningSoft": "#3A2F14", "success": "#6CCB95", "successSoft": "#17301F",
      "white": "#FFFFFF", "onAccent": "#0B1220", "wash": "#222830", "bubble": "#222830", "scrim": "rgba(0,0,0,0.6)"
    }
  }
}
