# Production settings for docker-compose.prod.yml. Copy to .env.prod (git-ignored) and fill in.
# SECRETS do NOT go here: put each one in its own file under ./secrets/ (also git-ignored), named exactly:
#   DB_PASSWORD  JWT_SECRET (64+ random chars)  REDIS_PASSWORD  SMTP_PASSWORD  GROQ_API_KEY  TURNIX_API_TOKEN (required)
# Generate random values with:  openssl rand -base64 48 | tr -d '/+=' > secrets/JWT_SECRET
# An unused secret (no coach key) must still exist as an empty file. TURNIX_API_TOKEN is required: the app refuses to start without it.

DOMAIN=speak.example.com
ACME_EMAIL=you@example.com
APP_NAME=Speakora

# Email (required: verification, password reset, reminders)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@example.com
MAIL_FROM=no-reply@speak.example.com

# Comma-separated emails that become administrators once verified
ADMIN_EMAILS=you@example.com

# TURN relay is provided by Turnix (see docs/TURN.md); the API token is the secret file secrets/TURNIX_API_TOKEN.
TURN_FORCE_RELAY=false

# AI coach (optional)
GROQ_MODEL=openai/gpt-oss-120b
COACH_DAILY_LIMIT=20

BACKUP_KEEP_DAYS=14

# Public address of the signed Android release APK. Leave empty until the APK is published: the website then shows no download button.
# With the bundled hosting (./downloads, see docs/DEPLOYMENT.md): https://${DOMAIN}/downloads/speakora.apk
ANDROID_DOWNLOAD_URL=
