# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- Branding (configurable) ---
APP_NAME=Speakora

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/english_speaking
DB_USER=esp_app
DB_PASSWORD=change-me

# --- Redis (Memurai on Windows dev, Redis in production) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT / cookies ---
JWT_SECRET=change-me-min-32-bytes-random
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- TURN relay via Turnix (https://turnix.io) ---
# Server-side only: the backend exchanges this token for short-lived ICE credentials. Never put it in the frontend or the Android app.
# Voice calls cannot start without it (the backend answers 503 TURN_NOT_CONFIGURED).
TURNIX_API_TOKEN=
# true = clients use TURN only (restrictive networks, or to test the relay path).
TURN_FORCE_RELAY=false
# Reverse proxies (IPs/CIDRs) whose X-Forwarded-For is believed when working out the caller's real IP for Turnix geo-routing.
# Empty = believe no header (correct when the backend is reached directly). Behind the bundled Caddy/nginx: 172.16.0.0/12,10.0.0.0/8
TRUSTED_PROXIES=

# --- Admin / moderation ---
# Comma-separated emails promoted to ADMIN once the address is VERIFIED (needs SMTP, or the logged link in dev).
ADMIN_EMAILS=

# --- AI tutor and coach: Groq, model openai/gpt-oss-120b (optional; the coach reports itself unavailable when no key is set). Never commit a real key. ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
COACH_DAILY_LIMIT=20

# --- Development ---
# true exposes Swagger UI at /swagger-ui.html
SWAGGER_ENABLED=false

# --- Email (needed for email verification / password reset; nothing set = emails are logged only in dev) ---
# Resend (HTTPS API, works where SMTP ports are blocked, e.g. Render Free). Takes precedence over SMTP when set. Server-side only; never in the website or app.
# Until you verify a domain at resend.com/domains, use MAIL_FROM=onboarding@resend.dev: Resend then delivers only to your own Resend account email.
RESEND_API_KEY=
# SMTP fallback, used only when RESEND_API_KEY is empty:
# Easiest: powershell -ExecutionPolicy Bypass -File tools\set-smtp.ps1 -Provider Brevo   (asks for the values, hides the key, writes them here)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sender ADDRESS, on a domain verified with your mail provider (production refuses an empty or example.com address).
# The name recipients see is always APP_NAME, so mail arrives as "Speakora <this address>". See docs/EMAIL.md.
MAIL_FROM=no-reply@example.com
APP_BASE_URL=http://localhost:5173
# Code emails are one plain-text message by default (reliable for a new Gmail sender). true also sends the HTML template as a second part.
# MAIL_HTML=false
# Most sign-up / reset code emails sent per day (the provider limits the sending account: Gmail about 500). 0 = no cap.
# MAIL_DAILY_LIMIT=400

# First administrator without email (docs/DEPLOYMENT.md, "First administrator"): a secret of 32+ random characters. Remove it once an admin exists.
# ADMIN_BOOTSTRAP_TOKEN=
